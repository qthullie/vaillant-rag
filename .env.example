# Copy to .env and adjust. Anything here overrides config.yaml.
# NEVER commit .env — it is gitignored.

# --- LLM endpoint (any OpenAI-compatible API) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=phi4-mini

# API key — leave empty for local servers (Ollama, LM Studio, vLLM).
# Required for hosted providers (OpenAI, Mistral, ...).
LLM_API_KEY=

# --- Optional overrides (defaults live in config.yaml) ---
# DOCS_DIR=data/docs
# INDEX_DIR=data/index
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# CHUNK_SIZE_CHARS=1000
# CHUNK_OVERLAP_CHARS=150
# TOP_K=20
# TOP_N_CONTEXTS=5
# USE_HYBRID_SEARCH=true
# RETRIEVAL_MODE=vector
# MARKDOWN_SECTION_MAX_CHARS=4000
# MARKDOWN_OUTLINE_LIMIT=150
# VECTOR_BACKEND=auto
# USE_RERANKER=false
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# OCR_IMAGES=false
# LOG_LEVEL=INFO
